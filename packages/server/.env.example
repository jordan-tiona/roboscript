# PostgreSQL connection string (Fly Postgres internal URL in prod)
DATABASE_URL=postgres://user:password@localhost:5432/roboscript

# Random secret for signing sessions — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me

# Full base URL of the auth API (used for password-reset links in emails)
BETTER_AUTH_URL=http://localhost:8080/api/auth

# URL of the frontend (used for CORS and trusted origins)
CLIENT_ORIGIN=http://localhost:5173

PORT=8080

# SMTP credentials for transactional email (password reset)
SMTP_HOST=mail.purelymail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=roboscript@purelymail.com
SMTP_PASS=

# Google reCAPTCHA v3 secret key (get from https://www.google.com/recaptcha/admin)
# Leave blank to skip verification in development
RECAPTCHA_SECRET_KEY=
